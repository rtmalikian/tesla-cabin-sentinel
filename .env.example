# Copy to .env (never commit .env) or run `tcsentinel setup` and answer a few
# plain-language questions — it writes .env for you.
#
# FUTURE-API NOTE: Tesla's Fleet API exposes no cabin camera or
# rear-occupant sensor today. Everything in this app works now (detection
# brain, alerts, AI endpoint, simulator) except a live check of a real car,
# which needs the endpoints proposed in API_PROPOSAL.md.
TESLA_CLIENT_ID=
TESLA_CLIENT_SECRET=
TESLA_REGION=na
TESLA_REDIRECT_URI=http://localhost:8080/callback

# Your cars: nickname=VIN pairs, comma-separated. A nickname alone works too
# (add the VIN later at pairing time). Find a VIN in the Tesla app under
# Controls -> Software.
TCS_VEHICLES=Model Y=,Model 3=

# The chat server this app exposes (OpenAI-compatible).
TCS_SERVER_HOST=127.0.0.1
TCS_SERVER_PORT=8645
TCS_SERVER_API_KEY=
TCS_MODEL_ID=tesla-cabin-sentinel

# Pluggable AI backend (any OpenAI-compatible API). Default: local Ollama.
# Set TCS_AI_MODE=never for built-in answers only — nothing leaves this computer.
TCS_AI_BASE_URL=http://localhost:11434/v1
TCS_AI_API_KEY=
TCS_AI_MODEL=llama3.1
TCS_AI_MODE=auto
TCS_AI_TIMEOUT_SECONDS=20
TCS_EMBEDDING_DIM=384
TCS_TOKEN_FILE=~/.tcs/tokens.json
TCS_DATA_DIR=~/.tcs
TCS_DRY_RUN=0

# Where alerts go: an ntfy.sh topic as "ntfy://your-topic", a webhook URL,
# or blank to print alerts only.
TCS_ALERT_DESTINATION=
# Minutes a child/pet may sit alone in a locked, parked car before the
# first alert fires (0 = right away). Parked cars heat fast — keep this short.
TCS_ALERT_AFTER_MINUTES=2
# Minutes after the first alert with no acknowledgement before escalation.
TCS_ESCALATE_AFTER_MINUTES=5
# How often the (future) cabin check runs while parked, in minutes.
TCS_CHECK_INTERVAL_MINUTES=1
# Minimum detector confidence (0-100) treated as a real occupant.
TCS_CONFIDENCE_THRESHOLD=70
# Cabin temperature (°F) at which an alert skips straight to escalation.
TCS_DANGER_TEMP_F=95
# With Dog Mode / climate on and the cabin at or below this temp, a pet
# alone is a watch, not an alert. (Children always alert, climate or not.)
TCS_CLIMATE_SAFE_MAX_F=85
